# Copie para infra/.env, ou rode: powershell -File infra/scripts/init-env.ps1 (gera segredos aleatórios e detecta o IP da rede local).
# Nunca versionar o .env.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=screenshare
POSTGRES_USER=screenshare
POSTGRES_PASSWORD=troque-me

# Sessão de convidado (cookie). Chave HS256 com no mínimo 32 caracteres, diferente da do SFU.
SESSION_SIGNING_KEY=troque-me-por-uma-chave-com-32-caracteres-ou-mais

# Redis
REDIS_PASSWORD=troque-me

# LiveKit (SFU). Segredo com no mínimo 32 caracteres.
LIVEKIT_API_KEY=screenshare
LIVEKIT_API_SECRET=troque-me-por-um-segredo-com-32-caracteres-ou-mais
# IP que o SFU anuncia aos navegadores. Dev: IP da máquina na rede local. Prod: IP público do servidor.
LIVEKIT_NODE_IP=192.168.1.10
LIVEKIT_USE_EXTERNAL_IP=false
# Porta UDP única (mux) para toda a mídia WebRTC.
LIVEKIT_UDP_PORT=7882
# URL de sinalização entregue ao navegador. Vazio = mesma origem da página (/rtc via proxy).
LIVEKIT_PUBLIC_URL=

# TURN (coturn)
TURN_SECRET=troque-me
# Host/IP que os navegadores usam para o TURN, e IP que o coturn anuncia como endereço de relay.
TURN_HOST=192.168.1.10
TURN_EXTERNAL_IP=192.168.1.10
TURN_RELAY_PORT_START=49160
TURN_RELAY_PORT_END=49359

# Rate limit por IP. Vazio = valores de produção (10 sessões/min, 30 salas/h, 60 consultas/min).
# Em desenvolvimento com testes E2E/carga (todos do mesmo IP), use valores altos:
RATE_LIMIT_SESSIONS_PER_MIN=
RATE_LIMIT_ROOMS_PER_HOUR_PER_IP=
RATE_LIMIT_ROOM_LOOKUPS_PER_MIN=
