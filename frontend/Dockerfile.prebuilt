# Publicação do frontend previamente validado: npm ci && npm run build.
FROM nginx:1.29-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=15s --start-interval=1s CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
