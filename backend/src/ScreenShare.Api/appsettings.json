{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": false },
  "ReverseProxy": { "TrustedNetworks": [] },
  "LiveKit": {
    "ApiUrl": "http://livekit:7880",
    "PublicUrl": "",
    "JoinTokenLifetime": "00:10:00",
    "EmptyTimeoutSeconds": 300,
    "DepartureTimeoutSeconds": 20
  },
  "Session": {
    "Lifetime": "12:00:00",
    "CookieName": "ss_session",
    "SecureCookie": true
  },
  "RateLimits": {
    "community-write": { "Limit": 60, "WindowSeconds": 60 },
    "auth-register":   { "Limit": 5, "WindowSeconds": 3600 },
    "auth-login":      { "Limit": 20, "WindowSeconds": 60 },
    "sessions":        { "Limit": 10, "WindowSeconds": 60 },
    "rooms-create":    { "Limit": 5,  "WindowSeconds": 60 },
    "rooms-create-ip": { "Limit": 30, "WindowSeconds": 3600 },
    "rooms-get":       { "Limit": 60, "WindowSeconds": 60 },
    "rooms-join":      { "Limit": 30, "WindowSeconds": 60 },
    "rooms-leave":     { "Limit": 30, "WindowSeconds": 60 }
  }
}
